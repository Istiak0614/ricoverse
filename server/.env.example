# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Use a separate database for dev.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ricoverse-dev?retryWrites=true&w=majority

# Comma-separated list of frontends allowed to call the API
CLIENT_URLS=http://localhost:5173

# Added in the Authentication module (WEB-3)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
