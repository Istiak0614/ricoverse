# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers. Use a separate database for dev.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ricoverse-dev?retryWrites=true&w=majority

# Comma-separated list of frontends allowed to call the API
CLIENT_URLS=http://localhost:5173

# Auth (WEB-3). Generate each secret with:  npm run secret
# Use DIFFERENT values for access and refresh, and new values in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# First admin account, created by:  npm run seed:admin
ADMIN_NAME=RICOVERSE Admin
ADMIN_EMAIL=admin@ricoverse.com
ADMIN_PASSWORD=ChangeMe123
